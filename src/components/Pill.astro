---
interface Props {
  href: string;
  label: string;
  variant?: 'sage' | 'rust' | 'blue' | 'light';
  small?: boolean;
  external?: boolean;
  reveal?: boolean;
  class?: string;
}
const { href, label, variant = 'sage', small = false, external = false, reveal = false, class: cls = '' } = Astro.props;
const classes = ['pill', variant !== 'sage' && `pill--${variant}`, small && 'pill--small', cls].filter(Boolean).join(' ');
---
<a
  class={classes}
  href={href}
  data-reveal={reveal ? 'fade' : undefined}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
>
  <span>{label}</span>
  <svg class="pill__arrow" viewBox="0 0 14 14" aria-hidden="true">
    <path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
  </svg>
</a>
