---
import '@fontsource-variable/inter';
import '@fontsource-variable/crimson-pro';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import Intro from '../components/Intro.astro';
import { getContent, href, locales, type Locale, type PageSlug } from '../i18n';
import { withBase } from '../lib/url';

interface Props {
  lang: Locale;
  page: PageSlug;
  title: string;
  description?: string;
  heroDark?: boolean;
  intro?: boolean;
}
const { lang, page, title, description, heroDark = false, intro = false } = Astro.props;
const c = getContent(lang);
const fullTitle = page === '' ? `${c.meta.siteName} — ${title}` : `${title} — ${c.meta.siteName}`;
const desc = description ?? c.meta.description;
const site = Astro.site;
---
<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content={heroDark ? '#141412' : '#ffffff'} />
    {import.meta.env.PUBLIC_NOINDEX === 'true' && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" sizes="64x64" href={withBase('/favicon-64.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={c.htmlLang.replace('-', '_')} />
    {site && locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l, page), site).href} />)}
    <link rel="preconnect" href="https://thumb.wikimedia.org" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!document.documentElement.classList.contains('motion-ready')) document.documentElement.classList.add('reveal-all');
      }, 4500);
    </script>
  </head>
  <body data-page={page || 'home'}>
    <a class="skip-link" href="#main">{c.ui.skip}</a>
    {intro && <Intro lang={lang} />}
    <Header lang={lang} page={page} onDark={heroDark} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <SearchOverlay lang={lang} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
