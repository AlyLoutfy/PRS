---
// Team — Figma 03_Web Design / Team, portraits exported from the file (Rebeca Juárez: monogram, no photo yet).
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import IntroRow from '../../components/IntroRow.astro';
import { getContent, staticLangPaths, type Locale } from '../../i18n';
import { team, personTitle, personRole, initials, type CountryKey } from '../../data/team';
import { contourSet } from '../../lib/contours';
import { withBase } from '../../lib/url';

export function getStaticPaths() {
  return staticLangPaths();
}
const lang = Astro.params.lang as Locale;
const c = getContent(lang);
const countries: CountryKey[] = ['ch', 'pe', 'mx', 'si', 'ec'];
const slug = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<Base lang={lang} page="team" title={c.team.title} description={c.team.text}>
  <PageHead title={c.team.title} index="05" section={c.nav.about} seed="team">
    <IntroRow label={c.team.label}>
      <p class="lead" data-reveal="lines">{c.team.text}</p>
    </IntroRow>
  </PageHead>

  <section class="section section--flush-top" data-filter-root>
    <div class="container">
      <div class="filters" data-reveal="fade">
        <button class="chip" type="button" data-filter="country" data-value="all" aria-pressed="true">{c.ui.all} <span class="chip__count">{team.length}</span></button>
        {countries.map((k) => (
          <button class="chip" type="button" data-filter="country" data-value={k} aria-pressed="false">
            {c.ui.countries[k]} <span class="chip__count">{team.filter((p) => p.country === k).length}</span>
          </button>
        ))}
      </div>
      <div class="grid team">
        {team.map((p) => {
          const set = contourSet(p.name, 300, 10);
          return (
            <article class="person" id={slug(p.name)} data-filter-item data-country={p.country}>
              <div class="person__portrait" data-reveal="media">
                {p.photo ? (
                  <img src={withBase(`/team/${p.photo}.webp`)} width="720" height="720" alt={p.name} loading="lazy" decoding="async" />
                ) : (
                  <>
                    <svg viewBox="0 0 300 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%">
                      {set.lines.map((l) => (
                        <path d={l.d} fill="none" stroke={l.index ? 'var(--blue)' : 'var(--ink)'} stroke-opacity={l.index ? 0.35 : 0.13} stroke-width="1" />
                      ))}
                      <circle cx={set.peak[0]} cy={set.peak[1]} r="2.2" fill="var(--rust)" />
                    </svg>
                    <span class="person__initials" aria-hidden="true">{initials(p.name)}</span>
                  </>
                )}
              </div>
              <h2 class="person__name">{p.name}</h2>
              <p class="person__role">
                {personTitle(p, lang)}<br />{personRole(p, lang)}<br /><span class="person__country">{c.ui.countries[p.country]}</span>
              </p>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</Base>
