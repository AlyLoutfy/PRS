---
// Card from the Figma "Übersicht" component: hairline, serif title, painting, text, optional button.
// With a link but no button the whole card is the link.
import Media from './Media.astro';
import Pill from './Pill.astro';
import type { ArtKey } from '../data/art';
import type { Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  text?: string;
  art?: ArtKey;
  href?: string;
  cta?: string;
  ctaVariant?: 'sage' | 'rust' | 'blue';
  bullets?: string[];
  ratio?: number;
  id?: string;
  /** attributes for an enquiry trigger on the button */
  lead?: { id: string; label: string; topic?: string };
}
const { lang, title, text, art, href, cta, ctaVariant = 'sage', bullets, ratio = 1.42, id, lead } = Astro.props;
const titleLink = href && !cta;
const leadAttrs = lead ? { 'data-lead-add': lead.id, 'data-lead-label': lead.label, 'data-lead-topic': lead.topic } : {};
---
<article class:list={['card', { 'card--link': titleLink }]} id={id}>
  <span class="rule" data-rule></span>
  <h3 class="h-card card__title" data-reveal="lines">
    {titleLink ? <a href={href}>{title}</a> : title}
  </h3>
  {art && <div class="card__media"><Media art={art} lang={lang} ratio={ratio} loupe={!titleLink} /></div>}
  <slot name="media" />
  {text && <p class="card__text" data-reveal="fade">{text}</p>}
  {bullets && (
    <ul class="card__list" data-reveal="fade">
      {bullets.map((b) => <li>{b}</li>)}
    </ul>
  )}
  {cta && href && <div class="card__cta" data-reveal="fade"><Pill href={href} label={cta} variant={ctaVariant} {...leadAttrs} /></div>}
</article>
