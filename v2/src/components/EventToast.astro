---
// Small dark notice for the upcoming Academy event (Figma note on the PRS Academy frame:
// "Pop up Black für Upcoming Event?"). Shown once per visitor until dismissed, and never after the event
// has ended. The script lives in src/scripts/main.ts (setupToast).
import { getContent, href, type Locale } from '../i18n';
interface Props { lang: Locale }
const { lang } = Astro.props;
const c = getContent(lang);
const e = c.event;
---
<aside class="toast" data-toast data-key={e.start} data-end={e.end} aria-label={e.label} hidden>
  <p class="meta toast__meta"><b>{e.label}</b><time datetime={e.start.slice(0, 10)}>{e.date}</time></p>
  <p class="toast__title">{e.title}</p>
  <a class="arrow-link toast__link" href={href(lang, 'academy', 'event')}>
    {c.ui.learnMore}
    <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
  </a>
  <button class="icon-btn toast__close" type="button" data-toast-close aria-label={c.popup.close}>
    <svg viewBox="0 0 18 18" aria-hidden="true"><path d="M4 4l10 10M14 4 4 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
  </button>
</aside>
