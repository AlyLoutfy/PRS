---
// Footer: claim, sitemap, the four offices (Figma: 03_Web Design / Kontakt + Footer), legal line and the
// v1 / v2 comparison switch.
import Pill from './Pill.astro';
import VersionSwitch from './VersionSwitch.astro';
import { getContent, href, type Locale, type PageSlug } from '../i18n';
import { offices, EMAIL, telHref } from '../data/offices';

interface Props { lang: Locale }
const { lang } = Astro.props;
const c = getContent(lang);
const groups = c.nav.mega.filter((g) => g.links.length > 0);
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <p class="site-footer__claim" data-reveal="lines">{c.footer.claim} <span>{c.footer.claimSub}</span></p>
      <div data-reveal="fade"><Pill href={href(lang, 'contact')} label={c.cta.contact} /></div>
    </div>

    <nav class="grid footer-nav" aria-label={c.ui.menu}>
      {groups.map((group) => (
        <div class="footer-nav__col" data-reveal="fade">
          <p class="footer-nav__title">{group.title}</p>
          <ul>
            {group.links.map((l) => (
              <li><a href={href(lang, l.page as PageSlug, 'hash' in l ? (l as { hash?: string }).hash : undefined)}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div class="footer-nav__col" data-reveal="fade">
        <p class="footer-nav__title">{c.nav.contact}</p>
        <ul>
          <li><a href={href(lang, 'contact', 'enquiry')}>{c.cta.enquiry}</a></li>
          <li><a href={`mailto:${EMAIL}`} title={EMAIL}>{c.lead.email}</a></li>
          <li><a href="https://www.linkedin.com/" rel="noopener" target="_blank" data-todo="PRS LinkedIn URL">{c.footer.linkedin}</a></li>
        </ul>
      </div>
      <div class="footer-nav__col" data-reveal="fade">
        <p class="footer-nav__title">{c.menu.legal}</p>
        <ul>
          <li><a href={href(lang, 'legal', 'imprint')}>{c.footer.imprint}</a></li>
          <li><a href={href(lang, 'legal', 'privacy')}>{c.footer.privacy}</a></li>
          <li><a href={href(lang, 'legal', 'credits')}>{c.footer.credits}</a></li>
        </ul>
      </div>
    </nav>

    <div class="grid footer-offices" aria-label={c.sections.offices}>
      {offices.map((o) => (
        <section class="footer-office" data-reveal="fade">
          <h2>{c.footer.offices[o.key]}</h2>
          {o.address && o.address.map((line) => <div>{line}</div>)}
          {o.address && <div>{c.ui.countries[o.key]}</div>}
          <div><a href={telHref(o.phone)}>T {o.phone}</a></div>
          <div><a href={`mailto:${EMAIL}`}>{EMAIL}</a></div>
        </section>
      ))}
    </div>

    <div class="footer-bottom">
      <span>{c.footer.copyright}</span>
      <VersionSwitch lang={lang} />
      <a class="footer-bottom__top" href="#top" data-to-top>
        {c.cta.backToTop}
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M6 11V1M2 5l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
      </a>
    </div>
  </div>
</footer>
