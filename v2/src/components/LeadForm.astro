---
// Enquiry form. It works in three ways, so no enquiry is lost while the backend is still to come:
//  1. PUBLIC_LEAD_ENDPOINT set at build time → the script (src/scripts/form.ts) POSTs JSON to it.
//  2. No endpoint (today) → the script opens the visitor's e-mail app with the enquiry prefilled.
//  3. No JavaScript → the browser submits the form itself (to the endpoint, or as a mailto: message).
// See README "Enquiry form" for the payload and how to connect a backend.
import { getContent, href, type Locale } from '../i18n';
import { EMAIL } from '../data/offices';

interface Props {
  lang: Locale;
  /** preselected topic */
  topic?: 'general' | 'models' | 'products' | 'standards' | 'academy';
  light?: boolean;
}
const { lang, topic = 'general', light = false } = Astro.props;
const c = getContent(lang);
const f = c.lead;
const endpoint = (import.meta.env.PUBLIC_LEAD_ENDPOINT as string | undefined) || '';
const topics = Object.entries(f.topics) as [keyof typeof f.topics, string][];
const strings = {
  email: EMAIL,
  topics: f.topics,
  remove: f.remove,
  submit: f.submit,
  sending: f.sending,
  errors: f.errors,
  success: f.success,
  mail: f.mail,
  failure: f.failure,
  mailSubject: f.mailSubject,
  mailFields: f.mailFields,
  retry: f.submit,
};
---
<form
  class="lead-form"
  method="post"
  action={endpoint || `mailto:${EMAIL}`}
  enctype={endpoint ? undefined : 'text/plain'}
  novalidate
  aria-label={f.formLabel}
  data-lead-form
  data-endpoint={endpoint || undefined}
  data-lang={lang}
>
  <fieldset class="topic-set">
    <legend>{f.topicLegend}</legend>
    <div class="topic-chips">
      {topics.map(([key, label]) => (
        <label class="topic-chip">
          <input type="radio" name="topic" value={key} checked={key === topic} />
          <span>{label}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="lead-tags" data-lead-tags hidden>
    <span class="lead-tags__label" id="lead-tags-label">{f.selection}</span>
    <ul class="lead-tags__list" data-lead-tags-list aria-labelledby="lead-tags-label"></ul>
  </div>

  <div class="lead-form__row">
    <div class="field" data-field="name">
      <label class="field__label" for="lead-name">{f.name}</label>
      <div class="field__box">
        <input class="field__control" id="lead-name" name="name" type="text" autocomplete="name" autocapitalize="words" required enterkeyhint="next" aria-describedby="lead-name-error" />
        <span class="field__line"></span>
        <svg class="field__check" viewBox="0 0 18 18" aria-hidden="true"><path d="M3.5 9.5 7.2 13 14.5 5" /></svg>
      </div>
      <p class="field__error" id="lead-name-error" hidden></p>
    </div>
    <div class="field" data-field="email">
      <label class="field__label" for="lead-email">{f.email}</label>
      <div class="field__box">
        <input class="field__control" id="lead-email" name="email" type="email" inputmode="email" autocomplete="email" autocapitalize="none" spellcheck="false" required enterkeyhint="next" aria-describedby="lead-email-error" />
        <span class="field__line"></span>
        <svg class="field__check" viewBox="0 0 18 18" aria-hidden="true"><path d="M3.5 9.5 7.2 13 14.5 5" /></svg>
      </div>
      <p class="field__error" id="lead-email-error" hidden></p>
    </div>
  </div>

  <div class="lead-form__row">
    <div class="field" data-field="company">
      <label class="field__label" for="lead-company">{f.company} <small>{f.optional}</small></label>
      <div class="field__box">
        <input class="field__control" id="lead-company" name="company" type="text" autocomplete="organization" enterkeyhint="next" />
        <span class="field__line"></span>
      </div>
    </div>
    <div class="field" data-field="phone">
      <label class="field__label" for="lead-phone">{f.phone} <small>{f.optional}</small></label>
      <div class="field__box">
        <input class="field__control" id="lead-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" enterkeyhint="next" />
        <span class="field__line"></span>
      </div>
    </div>
  </div>

  <div class="field" data-field="message">
    <label class="field__label" for="lead-message">{f.message}</label>
    <div class="field__box">
      <textarea class="field__control" id="lead-message" name="message" rows="4" maxlength="3000" required placeholder={f.messageHint} aria-describedby="lead-message-error"></textarea>
      <span class="field__line"></span>
    </div>
    <p class="field__error" id="lead-message-error" hidden></p>
  </div>

  <div class="consent" data-field="consent">
    <input type="checkbox" id="lead-consent" name="consent" value="yes" required aria-describedby="lead-consent-error" />
    <span class="consent__box" aria-hidden="true"><svg viewBox="0 0 14 14"><path d="M2.5 7.4 5.6 10.4 11.5 3.8" /></svg></span>
    <label for="lead-consent">{f.consent} <a href={href(lang, 'legal', 'privacy')}>{f.privacy}</a></label>
    <p class="field__error" id="lead-consent-error" hidden></p>
  </div>

  <p class="hp" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </p>
  <input type="hidden" name="language" value={lang} />

  <div class="lead-form__foot">
    <button class:list={['pill', 'pill--lg', light ? 'pill--ink' : 'pill--white']} type="submit" data-lead-submit data-magnetic>
      <span data-lead-submit-label>{f.submit}</span>
      <svg class="pill__arrow" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
      <span class="pill__spinner" aria-hidden="true"></span>
    </button>
    <p class="lead-form__note">{f.requiredNote}</p>
  </div>
  <p class="lead-form__status" role="alert" data-lead-status></p>
  <div data-lead-alert hidden></div>
  <script type="application/json" data-lead-strings set:html={JSON.stringify(strings).replace(/</g, '\\u003c')} />
</form>
<div class="lead-result" data-lead-result hidden tabindex="-1" role="status"></div>
