---
// Pill button from the Figma components: hairline outline that fills on hover. Renders a link when `href`
// is given, otherwise a <button>. Extra data-* attributes are passed through (used by the enquiry triggers).
interface Props {
  href?: string;
  label: string;
  variant?: 'sage' | 'solid' | 'ink' | 'white' | 'light' | 'rust' | 'blue';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  reveal?: boolean;
  arrow?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}
const { href, label, variant = 'sage', size = 'md', external = false, reveal = false, arrow = true, class: cls = '', ...rest } = Astro.props;
const classes = ['pill', variant !== 'sage' && `pill--${variant}`, size !== 'md' && `pill--${size}`, cls].filter(Boolean).join(' ');
const Tag = href ? 'a' : 'button';
---
<Tag
  class={classes}
  href={href}
  type={href ? undefined : 'button'}
  data-reveal={reveal ? 'fade' : undefined}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
  {...rest}
>
  <span>{label}</span>
  {arrow && (
    <svg class="pill__arrow" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.3" />
    </svg>
  )}
</Tag>
