---
// About — Figma 03_Web Design / Über uns + 02_Components / Übersicht.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import IntroRow from '../../components/IntroRow.astro';
import ArtCard from '../../components/ArtCard.astro';
import { getContent, href, staticLangPaths, type Locale, type PageSlug } from '../../i18n';
import type { ArtKey } from '../../data/art';

export function getStaticPaths() {
  return staticLangPaths();
}
const lang = Astro.params.lang as Locale;
const c = getContent(lang);
const a = c.about;
---
<Base lang={lang} page="about" title={a.title} description={a.intro.text}>
  <PageHead title={a.title} index="04" section={c.nav.about} seed="about">
    <IntroRow label={a.intro.label}>
      <p class="lead" data-reveal="lines">{a.intro.text}</p>
    </IntroRow>
  </PageHead>

  <section class="section section--flush-top">
    <div class="container grid trio">
      {a.cards.map((card) => (
        <ArtCard
          lang={lang}
          id={card.key}
          title={card.title}
          text={card.text}
          art={card.art as ArtKey}
          href={card.page ? href(lang, card.page as PageSlug) : undefined}
          cta={card.cta || undefined}
        />
      ))}
    </div>
  </section>
</Base>
