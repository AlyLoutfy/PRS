---
// PRS Academy — Figma 03_Web Design / PRS Academy.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import IntroRow from '../../components/IntroRow.astro';
import Pill from '../../components/Pill.astro';
import ArtCard from '../../components/ArtCard.astro';
import EventCard from '../../components/EventCard.astro';
import { getContent, href, staticLangPaths, swissNumber, type Locale } from '../../i18n';
import { courses } from '../../data/courses';
import type { ArtKey } from '../../data/art';

export function getStaticPaths() {
  return staticLangPaths();
}
const lang = Astro.params.lang as Locale;
const c = getContent(lang);
const a = c.academy;
const sorted = [...courses].sort((x, y) => x.title[lang].localeCompare(y.title[lang], lang));
---
<Base lang={lang} page="academy" title={a.title} description={a.intro.text} closing="form-academy" toast={false}>
  <PageHead title={a.title} index="02" section={c.nav.expertise} seed="academy">
    <IntroRow label={a.intro.label}>
      <p class="lead" data-reveal="lines">{a.intro.text}</p>
      <div data-reveal="fade"><Pill href={href(lang, 'curriculum')} label={a.intro.cta} /></div>
    </IntroRow>
  </PageHead>

  <section class="section section--flush-top">
    <dl class="container grid stats">
      {a.stats.map((s) => (
        <div data-reveal="fade">
          <dt class="fact__label">{s.label}</dt>
          <dd class="fact__num" data-count={s.value} data-suffix={s.suffix}>{swissNumber(s.value)}{s.suffix}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section section--flush-top" id="formats">
    <div class="container grid duo duo--centered">
      {a.formats.map((f) => (
        <ArtCard
          lang={lang}
          title={f.title}
          text={f.text}
          art={f.art as ArtKey}
          href="#enquiry"
          cta={f.cta}
          ratio={1.3}
          lead={{ id: `format:${f.key}`, label: `${c.shortlist.requestFormat}: ${f.title}`, topic: 'academy' }}
        />
      ))}
    </div>
  </section>

  <section class="section section--flush-top" id="curriculum">
    <div class="container">
      <IntroRow label={a.curriculum.label}>
        <ol class="topics" style={`--rows:${Math.ceil(sorted.length / 2)}`} data-reveal="fade">
          {sorted.map((k, i) => (
            <li><a href={href(lang, 'curriculum', k.id)}><span>{String(i + 1).padStart(2, '0')}</span>{k.title[lang]}</a></li>
          ))}
        </ol>
        <div data-reveal="fade"><Pill href={href(lang, 'curriculum')} label={a.curriculum.cta} /></div>
      </IntroRow>
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container"><EventCard lang={lang} formOnPage /></div>
  </section>
</Base>
