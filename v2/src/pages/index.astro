---
// "/" → the visitor's language (de / en / es), German by default.
import { withBase } from '../lib/url';
const base = withBase('');
---
<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PRS Prime Re Solutions</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" sizes="64x64" href={withBase('/favicon-64.png')} />
    <script is:inline define:vars={{ base }}>
      var langs = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || 'de']);
      var target = 'de';
      for (var i = 0; i < langs.length; i++) {
        var l = String(langs[i]).slice(0, 2).toLowerCase();
        if (l === 'de' || l === 'en' || l === 'es') { target = l; break; }
      }
      location.replace(base + '/' + target + '/');
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${withBase('/de/')}`} /></noscript>
  </head>
  <body>
    <a href={withBase('/de/')}>PRS Prime Re Solutions</a>
  </body>
</html>
